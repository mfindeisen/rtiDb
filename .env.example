# Production Environment Configuration for rtiDb
# Copy this file to `.env` on your server and modify the values.
# Required for Docker: ADMIN_PASSWORD and JWT_SECRET must be set.

# Administrator Username for the dashboard
ADMIN_USERNAME=admin

# Administrator Password (CHANGE THIS TO A SECURE PASSWORD)
ADMIN_PASSWORD=change_me_to_a_secure_password

# JWT Secret Key for token signing (CHANGE THIS to a random long string)
JWT_SECRET=change_this_to_a_random_long_string

# Keep source RTI files after processing (1 = archive under uploads/archive/, 0 = delete)
KEEP_ORIGINAL_RTI=1

# Max size per RTI/neural upload file (default 2GB)
# MAX_RTI_UPLOAD_BYTES=2147483648

# Comma-separated browser origins allowed to call the API with cookies (production).
# Defaults to PUBLIC_BASE_URL in production, or local Vite dev URLs in development.
# CORS_ORIGINS=https://rti.example.org

# Public site URL used for links, OpenAPI, and default CORS in production
# PUBLIC_BASE_URL=https://rti.example.org

# Trust X-Forwarded-* from the reverse proxy (production default: 1 hop).
# Set to 0/false if the Node process terminates TLS itself.
# TRUST_PROXY=1

# Failed login attempts per client IP before 429 (default 10 / 15 minutes)
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_MS=900000
